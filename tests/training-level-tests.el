(require 'ert)
(require 'org)
;; Run with: emacs -Q --batch -l tests/training-level-tests.el
(let ((init (expand-file-name "../init.el" (file-name-directory load-file-name))))
  (with-temp-buffer
    (insert-file-contents init)
    (goto-char (point-min))
    (search-forward "(defun my/org-training--next-level")
    (goto-char (match-beginning 0))
    (eval (read (current-buffer)) t)
    (eval (read (current-buffer)) t)))
(defmacro training-level-fixture (&rest body)
  `(let ((root (make-temp-file "training-levels-" t)))
     (unwind-protect
         (progn
           (make-directory (expand-file-name "training_journal" root))
           (make-directory (expand-file-name "03_pullups" root))
           (dolist (item '(("03_jackknife.md" . "Jackknife Pulls")
                           ("04_half.md" . "Half Pullups")
                           ("10_full.md" . "Full Pullups")))
             (with-temp-file (expand-file-name (concat "03_pullups/" (car item)) root)
               (insert "# " (cdr item) "\n")))
           (with-temp-buffer
             (setq buffer-file-name (expand-file-name "training_journal/training_journal.org" root))
             (insert "*** 2026-11\n\n| Date | Day | Exercise | Type | Set | Reps |\n|------+-----+----------+------+-----+------|\n| 2026-11-02 | | | work set | Jackknife Pulls | 4x10 |\n")
             (org-mode)
             (goto-char (point-max)) (forward-line -1)
             ,@body))
       (delete-directory root t))))
(ert-deftest training-level-advances-only-variation ()
  (training-level-fixture
   (let ((before (mapcar (lambda (col) (string-trim (org-table-get-field col))) '(1 2 3 4 6))))
     (my/org-increase-training-level)
     (should (equal "Half Pullups" (string-trim (org-table-get-field 5))))
     (should (equal before (mapcar (lambda (col) (string-trim (org-table-get-field col))) '(1 2 3 4 6))))
     (my/org-increase-training-level)
     (should (equal "Full Pullups" (string-trim (org-table-get-field 5)))))))
(ert-deftest training-level-final-and-unknown-unchanged ()
  (training-level-fixture
   (dolist (title '("Full Pullups" "Running" "Jackknife Pulls ; Half Pullups"))
     (org-table-goto-column 5) (org-table-blank-field) (insert title)
     (let ((before (buffer-string)))
       (should-error (my/org-increase-training-level) :type 'user-error)
       (should (equal before (buffer-string)))))))
(ert-deftest training-level-ambiguous-unchanged ()
  (training-level-fixture
   (with-temp-file (expand-file-name "03_pullups/05_duplicate.md" root)
     (insert "# Jackknife Pulls\n"))
   (let ((before (buffer-string)))
     (should-error (my/org-increase-training-level) :type 'user-error)
     (should (equal before (buffer-string))))))
(ert-deftest training-level-rejects-header ()
  (training-level-fixture
   (goto-char (point-min)) (search-forward "| Date")
   (should-error (my/org-increase-training-level) :type 'user-error)))
(ert-run-tests-batch-and-exit)
